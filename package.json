{
  "name": "map0-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "map0 — modern, embeddable, JSON-configurable web map client built on MapLibre GL JS",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "vite --config site/vite.config.ts",
    "build": "pnpm --filter @map0/ui build",
    "build:npm": "pnpm build && node scripts/build-npm.mjs",
    "build:site": "pnpm demo:standalone && vite build --config site/vite.config.ts",
    "serve": "vite preview --config site/vite.config.ts",
    "demo:standalone": "pnpm build && node -e \"const fs=require('node:fs');fs.rmSync('site/public/standalone',{recursive:true,force:true});fs.cpSync('packages/ui/dist','site/public/standalone',{recursive:true})\"",
    "size": "node scripts/check-size.mjs",
    "release": "node scripts/release.mjs",
    "typecheck": "tsc --build",
    "test": "vitest run",
    "smoke": "node e2e/smoke.mjs",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@release-it/conventional-changelog": "^12.0.0",
    "node-html-parser": "^9.0.1",
    "playwright": "^1.62.1",
    "release-it": "^21.0.2",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
