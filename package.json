{
  "name": "map0-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "map0 — modern, embeddable, JSON-configurable web map client built on MapLibre GL JS",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.14.0+sha512.c18ba6d87993d3d164cb5e8948f32b2c06ee854487e06cd8d86781342fb3e5bb4634367034711e86802baa9c37bea906ce1929ad08d70884c97d801df13389a6",
  "scripts": {
    "dev": "vite --config site/vite.config.ts",
    "build": "pnpm --filter @map0/ui build",
    "build:types": "node scripts/build-types.mjs",
    "build:npm": "pnpm build && pnpm build:types && node scripts/build-npm.mjs",
    "build:site": "pnpm demo:standalone && vite build --config site/vite.config.ts",
    "serve": "vite preview --config site/vite.config.ts",
    "demo:standalone": "pnpm build && node -e \"const fs=require('node:fs');fs.rmSync('site/public/standalone',{recursive:true,force:true});fs.cpSync('packages/ui/dist','site/public/standalone',{recursive:true})\"",
    "size": "node scripts/check-size.mjs",
    "docs:reference": "node scripts/config-reference.mjs",
    "og": "node scripts/og-image.mjs",
    "release": "node scripts/release.mjs",
    "typecheck": "tsc --build",
    "test": "vitest run",
    "smoke": "node e2e/smoke.mjs",
    "visual": "node e2e/visual.mjs",
    "visual:linux": "node scripts/visual-docker.mjs",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@release-it/conventional-changelog": "^12.0.2",
    "ace-builds": "^1.45.0",
    "dts-bundle-generator": "^9.5.1",
    "node-html-parser": "^9.0.4",
    "pixelmatch": "^8.0.0",
    "playwright": "^1.64.1",
    "pngjs": "^7.0.0",
    "release-it": "^21.1.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.4",
    "vitest": "^4.1.12"
  }
}
