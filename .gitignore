# Dependencies
node_modules/

# Build output
dist/
dist-types/
# Built demo site (`pnpm build:site`) — deployed, never committed
dist-site/
build/
*.tsbuildinfo

# Generated demo bundle (created by `pnpm demo:standalone`)
site/public/standalone/

# JSON Schema copied into the package by `pnpm build:npm` (canonical: packages/schema/v1.json)
packages/map0/schema/

# npm pack output (inspected before publish, never committed)
*.tgz

# E2E screenshot artifacts
e2e/shots/

# Test & coverage
coverage/
playwright-report/
test-results/

# Caches
.vite/
.cache/
.eslintcache
.turbo/

# Environment & secrets
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# OS junk
.DS_Store
Thumbs.db
Desktop.ini

# Editors
.idea/
.vscode/
*.swp

# Claude Code runtime/local files (shared settings may be committed deliberately)
.claude/settings.local.json
.claude/scheduled_tasks.lock
