.vite/
.cache/
.eslintcache
.turbo/

# Environment & secrets
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# OS junk
.DS_Store
Thumbs.db
Desktop.ini

# Editors
.idea/
.vscode/
*.swp

# Claude Code runtime/local files (shared settings may be committed deliberately)
.claude/settings.local.json
.claude/scheduled_tasks.lock
