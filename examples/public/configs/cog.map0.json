{
  "$schema": "https://map0.net/schema/v1.json",
  "version": 1,
  "meta": {
    "title": "Cloud Optimized GeoTIFF",
    "description": "COG overlays read directly from static storage — no tile server."
  },
  "map": { "bounds": [12.45, 46.95, 13.05, 47.3] },
  "basemaps": [
    {
      "id": "grau",
      "title": "basemap.at Grey",
